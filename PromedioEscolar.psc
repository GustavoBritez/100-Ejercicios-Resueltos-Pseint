Algoritmo PromedioEscolar
	
	Definir nota1,nota2,nota3 como entero;
	Definir promedio como real;
	
	Escribir " Ingrese nota 1";
	Leer nota1;
	Escribir " Ingrese nota2";
	Leer nota2;
	Escribir " Ingrese nota3";
	Leer nota3;
	
	promedio <- (nota1 + nota2 + nota2) / 3;
	
	Escribir " El promedio es " , trunc(promedio);
	
FinAlgoritmo
